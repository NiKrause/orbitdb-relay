{
  "name": "orbitdb-relay",
  "version": "0.10.2",
  "private": false,
  "type": "module",
  "description": "OrbitDB relay with media pinning and sync for Helia/libp2p stacks.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NiKrause/orbitdb-relay.git"
  },
  "bugs": {
    "url": "https://github.com/NiKrause/orbitdb-relay/issues"
  },
  "homepage": "https://github.com/NiKrause/orbitdb-relay#readme",
  "keywords": [
    "orbitdb",
    "libp2p",
    "helia",
    "ipfs",
    "relay",
    "pinning"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "orbitdb-relay": "dist/cli.js"
  },
  "scripts": {
    "start": "DEBUG=le-space:relay:* node dist/cli.js",
    "build": "node scripts/write-version.mjs && tsc -p tsconfig.json && node scripts/add-shebang.mjs",
    "test": "pnpm run build && mocha --timeout 180000 \"mocha/**/*.mjs\"",
    "test:integration:relay-media": "pnpm run build && mocha --timeout 180000 \"mocha/relay-media-replication.mjs\"",
    "prepack": "pnpm run build"
  },
  "overrides": {
    "it-length-prefixed": "9.1.1",
    "it-length-prefixed-stream": "2.0.6",
    "it-byte-stream": "2.0.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-quic": "^2.1.1",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@helia/bitswap": "^4.0.6",
    "@helia/http": "^4.0.5",
    "@helia/libp2p": "^1.0.6",
    "@helia/unixfs": "^8.0.4",
    "@ipld/dag-cbor": "^10.0.1",
    "@ipld/dag-json": "^11.0.0",
    "@ipshipyard/libp2p-auto-tls": "^1.0.0",
    "@le-space/orbitdb-access-controller-delegated-todo": "^0.1.0",
    "@le-space/orbitdb-identity-provider-webauthn-did": "^0.3.1",
    "@libp2p/autonat": "^3.0.24",
    "@libp2p/bootstrap": "^12.0.27",
    "@libp2p/circuit-relay-v2": "^4.2.9",
    "@libp2p/crypto": "^5.1.21",
    "@libp2p/dcutr": "^3.0.24",
    "@libp2p/gossipsub": "^16.1.0",
    "@libp2p/identify": "^4.1.10",
    "@libp2p/interface": "^3.2.5",
    "@libp2p/kad-dht": "^16.4.0",
    "@libp2p/keychain": "^6.1.4",
    "@libp2p/logger": "^6.2.10",
    "@libp2p/ping": "^3.1.9",
    "@libp2p/prometheus-metrics": "^5.0.25",
    "@libp2p/pubsub-peer-discovery": "^12.0.0",
    "@libp2p/tcp": "^11.0.24",
    "@libp2p/utils": "^7.3.0",
    "@libp2p/webrtc": "^6.0.27",
    "@libp2p/websockets": "^10.1.17",
    "@multiformats/multiaddr": "^13.0.3",
    "@multiformats/multiaddr-matcher": "^1.7.0",
    "@orbitdb/core": "^4.0.0",
    "@orbitdb/identity-provider-did": "^1.0.2",
    "blockstore-level": "^4.0.1",
    "datastore-level": "^13.0.1",
    "dotenv": "^16.5.0",
    "helia": "^7.1.0",
    "interface-blockstore": "^7.0.1",
    "interface-datastore": "^10.0.1",
    "key-did-resolver": "^4.0.0",
    "libp2p": "^3.3.6",
    "multiformats": "^14.0.3",
    "p-queue": "^8.1.0",
    "prom-client": "^15.1.3",
    "uint8arrays": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "mocha": "^11.7.2",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "it-length-prefixed": "9.1.1",
      "it-length-prefixed-stream": "2.0.6",
      "it-byte-stream": "2.0.6",
      "@libp2p/gossipsub": "16.1.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@le-space/orbitdb-access-controller-delegated-todo>@le-space/orbitdb-identity-provider-webauthn-did": "0.3.1",
        "@le-space/orbitdb-access-controller-delegated-todo>@orbitdb/core": "4.0.0"
      }
    },
    "onlyBuiltDependencies": [
      "node-datachannel"
    ]
  }
}
